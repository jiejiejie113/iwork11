{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash\\(git push.*\\)",
        "hook": "command",
        "command": "echo 'BLOCKED: git push 被禁用。请通过 PR/MR 提交代码。' && exit 1"
      },
      {
        "matcher": "Bash\\(git reset --hard.*\\)",
        "hook": "command",
        "command": "echo 'BLOCKED: git reset --hard 被禁用。使用 git stash 或分支隔离。' && exit 1"
      },
      {
        "matcher": "Bash\\(git clean -f.*\\)",
        "hook": "command",
        "command": "echo 'BLOCKED: git clean -f 被禁用。使用 git stash 代替。' && exit 1"
      },
      {
        "matcher": "Bash\\(git branch -D.*\\)",
        "hook": "command",
        "command": "echo 'WARNING: git branch -D 强制删除分支。确认要执行？' && exit 0"
      }
    ]
  },
